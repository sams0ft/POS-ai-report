# ===========================================
# POS Reportes IA — Variables de Entorno
# ===========================================

# --- Base de datos POS (READ-ONLY) ---
POS_DATABASE_URL=postgresql+asyncpg://readonly_user:password@localhost:5432/pos_db

# --- Base de datos Analítica (read-write) ---
ANALYTICS_DATABASE_URL=postgresql+asyncpg://analytics_user:password@localhost:5433/analytics_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM APIs ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
GEMINI_API_KEY=AIzaSyxxxxx

# --- App Config ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8001
TIMEZONE=America/Bogota

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
